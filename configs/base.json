{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "import",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "func-style": [
      "error",
      "expression",
      {
        "allowArrowFunctions": true
      }
    ],
    "prefer-arrow-callback": "error",
    "arrow-body-style": [
      "error",
      "as-needed"
    ],
    "no-var": "error",
    "prefer-const": [
      "error",
      {
        "destructuring": "any"
      }
    ],
    "no-param-reassign": [
      "error",
      {
        "props": true
      }
    ],
    "no-plusplus": "error",
    "no-void": "error",
    "no-else-return": [
      "error",
      {
        "allowElseIf": false
      }
    ],
    "no-lonely-if": "error",
    "curly": [
      "error",
      "all"
    ],
    "max-classes-per-file": [
      "error",
      0
    ],
    "oxc/no-this-in-exported-function": "error",
    "no-warning-comments": [
      "error",
      {
        "terms": [
          "todo",
          "fixme",
          "xxx",
          "hack"
        ],
        "location": "anywhere"
      }
    ],
    "max-lines": [
      "error",
      {
        "max": 200,
        "skipBlankLines": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 50,
        "skipBlankLines": true
      }
    ],
    "max-statements": [
      "error",
      20
    ],
    "max-depth": [
      "error",
      1
    ],
    "max-params": [
      "error",
      3
    ],
    "complexity": [
      "error",
      10
    ],
    "max-nested-callbacks": [
      "error",
      2
    ],
    "no-magic-numbers": [
      "error",
      {
        "ignore": [
          0,
          1,
          -1,
          2
        ],
        "ignoreArrayIndexes": true,
        "ignoreDefaultValues": true,
        "ignoreEnums": true,
        "ignoreNumericLiteralTypes": true,
        "enforceConst": true,
        "detectObjects": false
      }
    ],
    "no-await-in-loop": "error",
    "no-continue": "error",
    "no-labels": "error",
    "no-loop-func": "error",
    "guard-for-in": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/first": "error",
    "import/newline-after-import": "error",
    "import/no-namespace": "error",
    "import/no-mutable-exports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/explicit-module-boundary-types": "error",
    "typescript/method-signature-style": [
      "error",
      "property"
    ],
    "typescript/consistent-type-imports": "error",
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "object": "Declare the real shape instead of the broad object type.",
          "Record<string, unknown>": "Declare the real value type.",
          "Record<string, any>": "Declare the real value type."
        }
      }
    ],
    "typescript/no-empty-object-type": "error",
    "typescript/consistent-indexed-object-style": [
      "error",
      "record"
    ],
    "no-restricted-properties": [
      "error",
      {
        "object": "Reflect",
        "property": "get",
        "message": "Reflect.get returns any. Parse the value at the boundary instead."
      },
      {
        "object": "Reflect",
        "property": "apply",
        "message": "Reflect.apply returns any. Call the typed function instead."
      },
      {
        "object": "vi",
        "property": "mock",
        "message": "A module mock hides the real seam. Inject the dependency instead."
      },
      {
        "object": "vi",
        "property": "doMock",
        "message": "A module mock hides the real seam. Inject the dependency instead."
      },
      {
        "object": "jest",
        "property": "mock",
        "message": "A module mock hides the real seam. Inject the dependency instead."
      }
    ],
    "unicorn/prefer-at": "error",
    "unicorn/prefer-negative-index": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-includes": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/throw-new-error": "error",
    "unicorn/explicit-length-check": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/prefer-number-properties": "error",
    "prefer-exponentiation-operator": "error",
    "no-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "oxc/no-async-endpoint-handlers": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.js",
        "**/*.spec.js",
        "**/test/**",
        "**/tests/**",
        "**/__tests__/**"
      ],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "max-statements": "off",
        "max-nested-callbacks": "off",
        "no-magic-numbers": "off",
        "max-classes-per-file": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": [
        "**/*.d.ts"
      ],
      "rules": {
        "typescript/method-signature-style": "off",
        "typescript/no-explicit-any": "off",
        "max-lines": "off"
      }
    }
  ]
}
